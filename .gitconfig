[core]
    quotepath = false
    attributesfile = ~/.gitattributes
    excludesfile = ~/.gitignore_global
[color]
    ui = auto
[alias]
    st = status -sb
    df = diff
    co = checkout
    b = branch
    pl = pull
    ps = push
[pull]
    rebase = true
[push]
    default = current
[fetch]
    prune = true
[diff]
    algorithm = histogram
[merge]
    conflictstyle = zdiff3
[init]
    defaultBranch = main
# credential helper（gh 連携）はここに書かない。
# `gh auth login` が各自の ~/.gitconfig に machine 固有の絶対パスで書き込むため、
# 共有（追跡対象）ファイルに置くとマシン差分が混入する。各自 `gh auth login` で設定する。
[include]
    path = ~/.gitconfig.local
[includeIf "gitdir:~/workspaces/"]
    path = ~/.gitconfig.work
